<?xml version="1.0" encoding="utf-8"?>
<!-- Without a supportedOS entry Windows reports version 6.2 to the process, and msi.dll sets VersionNT = 602 in
     drive_dialog's session: version conditions then differ from msiexec's. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AdvancedInstallerMcp" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
